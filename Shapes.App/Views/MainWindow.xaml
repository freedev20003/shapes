<Window x:Class="Shapes.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shapes.App.Views"
        xmlns:converters="clr-namespace:Shapes.App.Converters"
        mc:Ignorable="d"
        Title="Геометрические фигуры"
        Height="600"
        Width="800">

    <Window.Resources>
        <converters:ShapeToDescriptionConverter x:Key="ShapeToDescriptionConverter"/>
        <converters:ShapeToVisualConverter x:Key="ShapeToVisualConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="5">
            <Button Content="Добавить фигуру"
                    Width="200"
                    Height="50"
                    HorizontalAlignment="Left"
                    Command="{Binding AddShapeCommand}"/>
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ShapeItems}"
                 Margin="5">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="0"
                                        Content="{Binding Converter={StaticResource ShapeToVisualConverter}}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Converter={StaticResource ShapeToDescriptionConverter}}"
                                   Padding="5"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <Button Grid.Column="2"
                                Content="Удалить"
                                Width="100"
                                Height="25"
                                Margin="5,0,0,0"
                                Padding="5"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.DeleteShapeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>