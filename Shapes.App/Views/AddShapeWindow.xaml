<Window x:Class="Shapes.App.Views.AddShapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Shapes.App.Converters"
        Title="Добавить фигуру"
        Height="400"
        Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <converters:ShapeTypeToStringConverter x:Key="ShapeTypeToStringConverter"/>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,5">
            <TextBlock Text="Тип фигуры:"
                       Margin="0,0,0,5"/>

            <ComboBox ItemsSource="{Binding AvailableShapeTypes}"
                      VerticalContentAlignment="Center"
                      SelectedItem="{Binding SelectedShapeType}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource ShapeTypeToStringConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Параметры:"
                   Margin="0,0,0,5"/>

        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Parameters}"
                      Margin="0,0,0,5">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,5">
                        <TextBlock Text="{Binding Definition.DisplayName}"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="5"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,0,0,5"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    Width="100"
                    Height="25"
                    Margin="0,0,5,0"/>

            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Width="100"
                    Height="25"/>
        </StackPanel>
    </Grid>
</Window>